{
  "manifest_version": 3,
  "name": "prifly Helper",
  "version": "0.1.0",
  "description": "Lets prifly's plugins fetch and run code in your own signed-in browser, paired with prifly on this machine.",
  "minimum_chrome_version": "135",
  "key": "",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "prifly Helper",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "permissions": [
    "alarms",
    "cookies",
    "declarativeNetRequestWithHostAccess",
    "storage",
    "tabs",
    "userScripts"
  ],
  "host_permissions": ["<all_urls>"]
}
