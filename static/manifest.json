{
  "manifest_version": 3,
  "name": "prifly Helper",
  "version": "0.1.0",
  "description": "Lets prifly's plugins fetch and run code in your own signed-in browser, paired with prifly on this machine.",
  "minimum_chrome_version": "135",
  "key": "",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "prifly Helper",
    "default_popup": "popup.html"
  },
  "permissions": [
    "alarms",
    "cookies",
    "declarativeNetRequestWithHostAccess",
    "storage",
    "tabs",
    "userScripts"
  ],
  "host_permissions": ["<all_urls>"]
}
